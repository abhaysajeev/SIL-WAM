# Copy to .env.prod and fill in real values before deploying
# Generate SECRET_KEY: openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=silwam
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sil_wam
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_run_openssl_rand_-hex_32
DEBUG=False
HTTPS_ONLY=True

# ── Meta / WhatsApp ─────────────────────────────────────────────────────────
FB_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ── Optional Redis (for wamid dedup fast path) ───────────────────────────────
# Leave empty to rely on DB unique index only
REDIS_URL=

# ── Lizo → SFA ──────────────────────────────────────────────────────────────
# Called when a customer taps Confirm Order on the template, to approve the order
# in SFA. Leave empty and the approval is never sent — orders are confirmed with
# us but stay unapproved on their side, so this must be set for Lizo.
# Prod: http://108.181.62.233:49009/api/Sfa/ApproveOrder
LIZO_APPROVE_ORDER_URL=

# The Confirm Order / Cancel template sent after the customer taps Confirm on the
# order message. Must be APPROVED on the company's WABA. Also the discriminator that
# tells the two "Confirm Order" buttons apart, so it must match the template's real
# name exactly. Defaults to order_confirm_liso when unset.
LIZO_CONFIRM_TEMPLATE=order_confirm_liso

# Central log server (log-ingestion). /client-api, /agent-api and /webhook calls are
# copied there in the background. Leave URL or KEY empty to switch it off.
# Get the key from: python3 scripts/add_project.py sil-wam "SIL WhatsApp" --profile sil-wam
LOG_INGEST_URL=
LOG_INGEST_KEY=
LOG_ENVIRONMENT=live

# ── Meta webhook ────────────────────────────────────────────────────────────
# Extra app secrets accepted on webhook signatures, comma-separated — one per Meta app
# subscribed to a company's WABA (META_APP_SECRET is always accepted too).
META_APP_SECRETS=
# off | shadow | on. shadow = store every webhook AND process it the old way, to
# compare counts before switching to on (store first, then process).
WEBHOOK_INBOX_MODE=shadow

# ── Media files (broadcast images) ─────────────────────────────────────────
# local = files on the app's disk under MEDIA_LOCAL_DIR (mount a volume there to keep
# them across container rebuilds). s3 = an S3-compatible store such as MinIO.
MEDIA_STORE=local
MEDIA_LOCAL_DIR=var/media
# Only for MEDIA_STORE=s3:
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=wam-media
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_RETENTION_DAYS=30

# ── Agent app push notifications (Android, Firebase Cloud Messaging) ─────────
# Path inside the container to the Firebase service-account JSON. Empty = no pushes
# (the app still syncs on open and over /agent-api/v1/events).
FCM_SERVICE_ACCOUNT_FILE=

# ── Account-level failures (billing 131042, locked 131031, policy 368) ───────
# alert = flag the account + error log; enforce = also pause the campaign and refuse
# agent sends until a message is delivered again. Start with alert.
ACCOUNT_BREAKER_MODE=alert
