# Copy to .env.prod and fill in real values before deploying
# Generate SECRET_KEY: openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=silwam
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sil_wam
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_run_openssl_rand_-hex_32
DEBUG=False
HTTPS_ONLY=True

# ── Meta / WhatsApp ─────────────────────────────────────────────────────────
FB_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ── Optional Redis (for wamid dedup fast path) ───────────────────────────────
# Leave empty to rely on DB unique index only
REDIS_URL=

# ── Lizo → SFA ──────────────────────────────────────────────────────────────
# Called when a customer taps Confirm Order on the template, to approve the order
# in SFA. Leave empty and the approval is never sent — orders are confirmed with
# us but stay unapproved on their side, so this must be set for Lizo.
# Prod: http://108.181.62.233:49009/api/Sfa/ApproveOrder
LIZO_APPROVE_ORDER_URL=

# The Confirm Order / Cancel template sent after the customer taps Confirm on the
# order message. Must be APPROVED on the company's WABA. Also the discriminator that
# tells the two "Confirm Order" buttons apart, so it must match the template's real
# name exactly. Defaults to order_confirm_liso when unset.
LIZO_CONFIRM_TEMPLATE=order_confirm_liso
